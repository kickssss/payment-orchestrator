# Every var is optional - defaults live in src/platform/config.ts.
# Copy to .env (bun loads it automatically) or export inline.

# processes
# PORT=3000                    # api
# BANK_PORT=4000                # simbank
# BANK_URL=http://127.0.0.1:4000
# DB_PATH=run/orchestrator.db   # THE shared state - same file for api + workers
# API_KEY=devkey               # required by /v1/* and /admin/* (header: x-api-key)

# worker loops
# RELAY_INTERVAL_MS=100
# SYNC_INTERVAL_MS=2000
# SWEEP_INTERVAL_MS=1000
# WORKER_HEALTH_PORT=0         # 0 = ephemeral; set explicitly to poll it
# WORKER_ID=                   # default: w-<pid>-<rand>
# DRAIN_DEADLINE_MS=10000

# deterministic crash injection (e2e fault scenarios)
# FAULT_CRASH_AFTER_HOLD=0
# FAULT_CRASH_AFTER_SUBMIT=0

# module timings (the e2e shrinks these so recovery takes seconds, not minutes)
# EXEC_DELAY_MS=1000
# STALE_HELD_MS=60000
# RECONCILE_DELAY_MS=30000
# MAX_RECONCILE_AGE_MS=86400000
# DEFER_BACKOFF_MS=5000
# CLAIM_TTL_MS=60000
# GATE_TTL_MS=60000
